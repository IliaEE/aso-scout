# --- storage -------------------------------------------------------------
# On Railway point this at the mounted volume, e.g. /data/aso_scout.db
# Locally the default is fine.
SQLITE_PATH=aso_scout.db

# --- report access (required by the worker) ------------------------------
# The server refuses to start without these rather than exposing the queue.
AUTH_USER=
AUTH_PASS=

# --- Apple ---------------------------------------------------------------
# ~20 req/min per IP is the observed ceiling. Do NOT raise this and do NOT
# add proxy rotation.
RPM=18
MAX_RETRIES=4
TIMEOUT=20

# Put a real contact address here. A traceable UA is the difference between
# being throttled and being banned.
USER_AGENT=aso-scout/0.1 (keyword research; contact: you@example.com)

# --- autonomous schedule -------------------------------------------------
# UTC hours to collect. More runs widen keyword coverage; they do NOT speed
# up review deltas, which are keyed by calendar day.
COLLECT_HOURS=3,11,19
ROOTS_PER_RUN=8

# Minimum age before a probed prefix is worth revisiting. Matters once you
# run several times a day: Apple's suggestions move over weeks, not hours.
REPROBE_AFTER_DAYS=7
MAX_SNAPSHOTS=60
STORES=us,gb,ca,au

# --- daily digest (optional) ---------------------------------------------
# @BotFather -> /newbot for the token. Message the bot once, then read
# chat.id from https://api.telegram.org/bot<TOKEN>/getUpdates
# Unset = no digest; it never blocks a collection run.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
COLLECT_ON_BOOT=false   # set true for the first deploy to verify end to end

# --- report --------------------------------------------------------------
QUEUE_SIZE=50
REPORT_SIZE=3
ASTRO_SLOTS=40

# --- LLM judge (optional) -------------------------------------------------
# console.groq.com -> API Keys. Without it the pipeline runs on heuristics.
# The model is auto-detected from what your account can call; set GROQ_MODEL
# only to pin a specific one.
GROQ_API_KEY=
GROQ_MODEL=
JUDGE_PER_RUN=30

# Pacing. The free tier's binding limit is TOKENS per minute, not requests:
# "tokens per minute (TPM): Limit 8000" with ~950 tokens per judgement means
# about 8 calls a minute. Raise GROQ_TPM if you upgrade the plan.
GROQ_TPM=8000
GROQ_TOKENS_PER_CALL=1000
GROQ_RPM=30

# --- idea generation (optional, needs GROQ_API_KEY) -----------------------
# The model proposes adjacent queries; each is then verified against Apple's
# autocomplete and SERP before it can enter the queue. Set IDEATE=0 to stop.
# Check whether it earns its keep: python -m src.jobs.ideate --stats
IDEATE=1
IDEATE_SEEDS=5

# Judging and ideation can use different keys, models and even providers.
# Unset values fall back to the GROQ_* settings above.
#
# NOTE: a second key on the SAME Groq account buys no extra throughput —
# the limit is per organization, as the 429 body states. Use a smaller model
# here, or point IDEATE_BASE_URL at another OpenAI-compatible provider with
# its own budget (Gemini's free tier, for instance).
JUDGE_MODEL=
IDEATE_API_KEY=
IDEATE_MODEL=
IDEATE_BASE_URL=
IDEATE_TPM=
